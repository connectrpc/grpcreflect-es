{
  "name": "@connectrpc/grpcreflect",
  "version": "0.1.0",
  "description": "gRPC server reflection for Connect",
  "keywords": [
    "javascript",
    "typescript",
    "protobuf",
    "grpc",
    "rpc",
    "connectrpc",
    "reflection",
    "grpcurl"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/connectrpc/grpcreflect-es",
  "bugs": {
    "url": "https://github.com/connectrpc/grpcreflect-es/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/connectrpc/grpcreflect-es.git",
    "directory": "packages/grpcreflect"
  },
  "scripts": {
    "generate": "buf generate",
    "postgenerate": "license-header src/gen",
    "test": "tsc --noEmit && tsx --test --test-reporter=tap src/*.test.ts",
    "test:bun": "bun test",
    "prebuild": "rm -rf ./dist/*",
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc --project tsconfig.build.json --module commonjs --moduleResolution bundler --verbatimModuleSyntax false --outDir ./dist/cjs && echo >./dist/cjs/package.json '{\"type\":\"commonjs\"}'",
    "build:esm": "tsc --project tsconfig.build.json --outDir ./dist/esm",
    "format": "biome format --write",
    "lint": "biome lint --error-on-warnings",
    "attw": "attw --pack && publint --strict",
    "license-header": "license-header"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.5.0",
    "@connectrpc/connect": "^2.0.0"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0"
  }
}
