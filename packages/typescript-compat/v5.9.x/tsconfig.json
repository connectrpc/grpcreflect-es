{
  "include": [
    "./src/**/*.ts",
    "../../example/src/**/*.ts",
    "../../runtime-tests/src/smoke.ts"
  ],
  // These are the default compiler options for TypeScript v5.9.x, created
  // with `tsc --init` (except where noted in comments below)
  "compilerOptions": {
    // The test sources live in sibling packages.
    "rootDir": "../..",
    "module": "nodenext",
    "target": "esnext",
    // The example uses Node.js APIs.
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    // To guard against regression and ensure we are remaining backwards
    // compatible, set the skipLibCheck flag to false explicitly.
    "skipLibCheck": false
  }
}
