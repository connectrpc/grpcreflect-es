{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/tsconfig.*.json",
      "!**/src/gen",
      "!**/dist",
      "!**/.turbo",
      "!**/node_modules"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "useTemplate": "off",
        "noParameterAssign": "off",
        "useNumberNamespace": "off"
      },
      "suspicious": {
        "noDoubleEquals": "off"
      }
    }
  }
}
