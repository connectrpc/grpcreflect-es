{
  "private": true,
  "scripts": {
    "clean": "git clean -Xdf",
    "all": "turbo run --ui tui build format test lint attw license-header",
    "setversion": "node scripts/set-workspace-version.js",
    "postsetversion": "npm run all",
    "format": "biome format --write",
    "license-header": "license-header --ignore 'packages/**'",
    "lint": "biome lint --error-on-warnings"
  },
  "workspaces": [
    "packages/grpcreflect",
    "packages/example",
    "packages/runtime-tests",
    "packages/typescript-compat/*"
  ],
  "type": "module",
  "engineStrict": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "packageManager": "npm@11.20.0",
  "licenseHeader": {
    "licenseType": "apache",
    "yearRange": "2025-2026",
    "copyrightHolder": "The Connect Authors"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.6",
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/license-header": "^0.0.4",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@types/node": "^26.6.6",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
