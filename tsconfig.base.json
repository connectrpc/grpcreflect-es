{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["ES2020"],
    "declaration": true,
    // Prevent tsc from picking up @types/node and others. The library must
    // not depend on APIs of a specific runtime.
    "types": [],
    // As strict as possible
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    // Require explicit types for exports, so that declarations can be
    // generated without type information.
    "isolatedDeclarations": true,
    // We're building with Node16 module resolution
    "moduleResolution": "Node16",
    "module": "Node16",
    "verbatimModuleSyntax": true,
    "skipLibCheck": false
  }
}
